-- window functions
-- rank pgs by rent
select pg_name,rent ,rank() over(order by rent desc) as pg_rank from pg_properties;
-- rank pgs by rating
select pg_name,rating,rank() over(order by rating desc) as rating_rank ,
dense_rank() over(order by rating desc) as denserating_rank from pg_properties;
select pg_name,rating,dense_rank() over(order by rating desc) as rating_rank from pg_properties;
-- rank by each category
select category,pg_name,rent from pg_properties where category in ("gents","ladies"); -- partition
-- category wise rank
select category,pg_name,rent, rank() over(partition by category order by rent desc) from pg_properties;
-- top 3 pgs by category
select * from (select category,pg_name,rent,rating,rank() over(partition by category order by rating desc) as rent_rank
  from pg_properties) as desire_table where rent_rank <=3  ;
  
  




 
 
 





