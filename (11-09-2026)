select * from pg_properties;   -- 1
select PG_id, PG_name, address_area, Category, Rent, Rating from pg_properties; -- 2
-- 3. Find PGs located in Marathahalli
select pg_name,address_area from pg_properties where address_area like "%marathahalli%";
-- 4. Find PGs with rent less than ₹8,000  5. Find PGs with rent between ₹6,000 and ₹10,000  6. Find PGs with rating greater than 4
select pg_name,rent from pg_properties where rent<8000;
select pg_name,rent from pg_properties where rent>=6000 and rent<=10000;
select pg_name,rent from pg_properties where rent between 6000 and 10000;

select pg_name,rating from pg_properties where rating>4;
-- Find all Ladies PGs  Find all Gents PGs with CCTV   Find PGs where parking is available   10. Find PGs where self-cooking is available
select pg_name,category from pg_properties where category="ladies";
select pg_name,securitycctv,category from pg_properties where category="gents";
select pg_name,parking from pg_properties where parking="yes";
select pg_name,self_cooking from pg_properties where self_cooking="yes";
-- Find PGs with either Gym or Lift  Find PGs with both Gym and Lift    Find PGs where deposit is below ₹5,000 Find PGs established after 2020
select pg_name,gym,lift from pg_properties where gym="yes"or lift="yes";
select pg_name,gym,lift from pg_properties where gym="yes"and lift="yes";
select pg_name,deposit from pg_properties where deposit<5000;
select pg_name,estb_year from pg_properties where estb_year>2020;
