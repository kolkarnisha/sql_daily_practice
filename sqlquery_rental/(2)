USE tempdb;
GO

CREATE TABLE pg_properties (
    PG_id INT PRIMARY KEY IDENTITY(1,1),
    PG_name VARCHAR(150) NOT NULL,
    Estb_year INT,
    Address_Area VARCHAR(255) NOT NULL,
    Pincode CHAR(6),
    Category VARCHAR(30),
    City VARCHAR(50) DEFAULT 'Bangalore',
    State VARCHAR(50) DEFAULT 'Karnataka',
    Owner_Name VARCHAR(100),
    Parking VARCHAR(3) CHECK (Parking IN ('Yes','No')) DEFAULT 'No',
    Gym VARCHAR(3) CHECK (Gym IN ('Yes','No')) DEFAULT 'No',
    Lift VARCHAR(3) CHECK (Lift IN ('Yes','No')) DEFAULT 'No',
    Contact VARCHAR(20),
    Rent DECIMAL(10,2) NOT NULL,
    Sharing VARCHAR(30),
    Deposit DECIMAL(10,2),
    Food_Specials VARCHAR(255),
    Facilities TEXT,
    Feedback TEXT,
    Rules TEXT,
    Rating DECIMAL(2,1),
    SecurityCCTV VARCHAR(3) CHECK (SecurityCCTV IN ('Yes','No')) DEFAULT 'No',
    Self_Cooking VARCHAR(3) CHECK (Self_Cooking IN ('Yes','No')) DEFAULT 'No',
    CHECK (Rating >= 0 AND Rating <= 5),
    CHECK (Rent >= 0),
    CHECK (Deposit >= 0)
);
