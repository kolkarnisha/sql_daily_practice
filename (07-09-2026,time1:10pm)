describe pg_properties;
show create table pg_properties;
select pg_name,rent from pg_properties where rent<=8000;
select pg_name,rent from pg_properties where address_area="marathalli" and rent<=8000;
-- select pg_name,rent from pg_properties where "marthalli" in address_area and rent<=8000;
select pg_name,rent from pg_properties where address_area like "%Marathahalli%" and rent<=8000;
select pg_name,rent,rating,deposit from pg_properties where sharing="double" and rent<=10000;
-- pg with cctv ,gym,lift
select pg_id,pg_name from pg_properties where securitycctv="yes" and gym="yes" and lift="yes";
-- top rated pg
select pg_name,rating from pg_properties where rating>=4;
select pg_name,rating from pg_properties order by rating desc;
-- 5 cheapest pgs without where
select pg_name,rent from pg_properties order by rent limit 5 ;
-- find out what is the average rent in bangalore
select address_area,avg(rent)  as average from pg_properties group by address_area;
select address_area,max(rent),min(rent),count(*),avg(rent) from pg_properties group by address_area;
select category,max(rent),min(rent),count(*),avg(rent) from pg_properties group by category;
-- categorize pgs by rent (budget,midrange,premium)
select pg_name,rent ,CASE when rent<6000 then "budget" 
         when rent<10000 then "midrange" else  "premium" end  as rent_category from pg_properties;
-- rating classification 
select upper(pg_name),lower(pg_name),concat(pg_name,"_",address_area),
length(pg_name),substring(pg_name,3,5),trim(pg_name) from pg_properties;
-- numeric functions
select round(rent/30),ceil(rent/30),floor(rent/30),abs(rent-8000) from pg_properties;
-- null functions
select coalesce(contact,"notprovided") as phone_num from pg_properties;
select ifnull(contact,"notprovided") from pg_properties;
select nullif(contact,pg_name) from pg_properties;
-- date functions
select pg_name, estb_year from pg_properties;
select PG_name,year(curdate())-estb_year as property_age from pg_properties;



