CREATE DATABASE marathahalli_rental;
USE marathahalli_rental;
-- *Step-2: Create the master table*

CREATE TABLE pg_properties (
    PG_id INT PRIMARY KEY AUTO_INCREMENT, -- Because it uniquely identifies every PG
    PG_name VARCHAR(150) NOT NULL,
    Estb_year YEAR, -- Bcz We don't need 2018-04-21 10:30:00
 
    Address_Area VARCHAR(255) NOT NULL,
    Pincode CHAR(6),
    Category VARCHAR(30),
    City VARCHAR(50) DEFAULT 'Bangalore',
    State VARCHAR(50) DEFAULT 'Karnataka',
    Owner_Name VARCHAR(100),
    Parking ENUM('Yes', 'No') DEFAULT 'No',
    Gym ENUM('Yes', 'No') DEFAULT 'No',
    Lift ENUM('Yes', 'No') DEFAULT 'No', -- For large projects use BOOLEAN/TINYINT

    Contact VARCHAR(20),
    Rent DECIMAL(10,2) NOT NULL, -- Do not use FLOAT for money

    Sharing VARCHAR(30),
    Deposit DECIMAL(10,2),
    Food_Specials VARCHAR(255),
    Facilities TEXT,
    Feedback TEXT,
    Rules TEXT,
    Rating DECIMAL(2,1),
    SecurityCCTV ENUM('Yes', 'No') DEFAULT 'No',
    Self_Cooking ENUM('Yes', 'No') DEFAULT 'No',
    CHECK (Rating >= 0 AND Rating <= 5),
    CHECK (Rent >= 0),
    CHECK (Deposit >= 0)
);
