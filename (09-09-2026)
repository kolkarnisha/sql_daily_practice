-- CTE + window function
-- find the top 2 cheapest pg in each category
show databases;
use marathahalli_rental;
show tables;
select * from pg_properties;
with cheapestpg as (
         select rent,Pg_name,category,row_number()
         over (partition by category order by rent ) 
           as rn from pg_properties )
         select * from cheapestpg  where rn<=2;
/* 5500.00	Budget Stay PG	Gents	1
9000.00	Smart Living PG	Gents	2
6500.00	Comfort Homes PG	Ladies	1
7500.00	Green View Ladies PG	Ladies	2
6000.00	Affordable Nest	Unisex	1
8500.00	Urban Nest PG	Unisex	2 */
-- CTE +RNK()
-- find all the pgs matched for the best rating within each category
with bestrating as(
         select pg_name,rating,category,rank() 
         over( partition by category order by rating desc)
         as br from pg_properties)
         select * from bestrating where br=1;
/*Green View Ladies PG	4.6	Ladies	1
