create table products(
          product_id int primary key auto_increment,
          product_name varchar(50) not null,
          category varchar(50) );
insert into products(product_id,product_name,category) values
       (10,"iphone-16pro","mobile"),(20,"mac-air","laptop"),(30,"airpods-pro","audio"),(40,"ipad-air","tablet");
select * from products;
select c.customer_name,o.order_id,p.product_name,o.amount 
from customers AS c JOIN orders as o
    on c.customer_id=o.customer_id
join products as p
	on o.product_id=p.product_id;
select c.customer_id,c.customer_name,o.order_id,o.amount 
from customers as c
left join orders as o 
on c.customer_id=o.customer_id;
select c.customer_name,o.order_id
from customers as c
right join orders as o 
on c.customer_id=o.customer_id;
-- here many developers simply rewrite 'right join' as 'left join'
select c.customer_id,c.customer_name,o.order_id,o.amount 
from orders as o
left join customers as c
on c.customer_id=o.customer_id;
