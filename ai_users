create database if not exist algonex;
use algonex;
CREATE TABLE ai_users (
    user_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    age INT,
    ai_tool_used VARCHAR(50),
    ai_expert_in VARCHAR(100),
    task_using_ai VARCHAR(150),
    employment_status VARCHAR(20) CHECK (employment_status IN ('Employed', 'Looking for Job', 'Unemployed')),
    job_title VARCHAR(100),
    years_of_experience DECIMAL(3,1),
    tokens_used_per_day INT,
    amount_paid_per_day DECIMAL(10,2),
    city VARCHAR(50),
    signup_date DATE
);

