-- select pg_name,rating order by rating desc from pg_properties;
select * from (
 select pg_name,rent,row_number() over(order by rent) as  rn 
    from pg_properties) as t  where rn=1 ;
select * from (
 select pg_name,rent,row_number() over(order by rent desc) as  rn 
    from pg_properties) as t  where rn=1 ;
/* Find average rent. Find total PGs. Find average rating.*/
select rent,avg(rent) over(partition by rent ) from pg_properties ;
select rating,avg(rating) over(partition by rating) from pg_properties;

